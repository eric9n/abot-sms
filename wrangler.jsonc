{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abot-sms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  // The routes have no caller authentication. The only entry point is the
  // abot-gateway service binding (BACKEND_SMS); never expose a public URL.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Names only. Values are set with `wrangler secret put` or .dev.vars, never committed.
  // AIR_BROKER_DEVICE_ID and AIR_BROKER_DEVICE_TOKEN are optional (device-token WebSocket).
  "secrets": {
    "required": ["AIR_BROKER_URL", "AIR_BROKER_ACCESS_CODE"]
  }
}
